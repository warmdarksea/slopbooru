{
  "name": "pixai",
  "input": {
    "max_pixels": null
  },
  "kind": "tagger",
  "server": {
    "input_size": 1008
  },
  "runner": {
    "type": "pixai",
    "batch": 16,
    "device": "cuda"
  },
  "request": {
    "threshold_general": null,
    "threshold_character": null
  },
  "output": {
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "subjects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "probability": {
              "type": "number"
            }
          }
        }
      },
      "source": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "rating": {
        "type": "string",
        "enum": [
          "safe",
          "sensitive",
          "questionable",
          "explicit"
        ]
      }
    }
  }
}
