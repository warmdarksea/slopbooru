{
  "name": "llamaguard",
  "input": {
    "max_pixels": 2500000,
    "resize": "catmull-rom/png v1"
  },
  "kind": "guard",
  "server": {
    "max_model_len": 8192,
    "generation_config": "vllm",
    "limit_mm_per_prompt": {
      "image": 1,
      "video": 0
    }
  },
  "runner": {
    "type": "vllm",
    "gpu": 0.9,
    "max_num_seqs": 4
  },
  "needs": {
    "model": "gemma",
    "field": "description",
    "limit": 1
  },
  "output": {
    "type": "object",
    "properties": {
      "verdict": {
        "type": "string",
        "enum": [
          "safe",
          "unsafe"
        ]
      },
      "hazards": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "child exploitation",
            "code interpreter abuse",
            "defamation",
            "elections",
            "hate",
            "indiscriminate weapons",
            "intellectual property",
            "non-violent crimes",
            "privacy",
            "self-harm",
            "sex crimes",
            "sexual content",
            "specialized advice",
            "violent crimes"
          ]
        }
      },
      "confidence": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "number"
          }
        }
      }
    }
  },
  "request": {
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "image_url",
            "image_url": {
              "url": "{image}"
            }
          },
          {
            "type": "text",
            "text": "{context}"
          }
        ]
      }
    ],
    "temperature": 0.0,
    "top_p": 1.0,
    "top_k": -1,
    "max_tokens": 32,
    "logprobs": true,
    "top_logprobs": 20
  }
}
