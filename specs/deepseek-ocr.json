{
  "name": "deepseek-ocr",
  "input": {
    "max_pixels": 2500000,
    "resize": "catmull-rom/png v1"
  },
  "kind": "ocr",
  "server": {
    "max_model_len": 8192,
    "generation_config": "vllm",
    "limit_mm_per_prompt": {
      "image": 1,
      "video": 0
    }
  },
  "runner": {
    "type": "vllm",
    "gpu": 0.32,
    "max_num_seqs": 4
  },
  "output": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "boxes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "box": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "request": {
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "image_url",
            "image_url": {
              "url": "{image}"
            }
          },
          {
            "type": "text",
            "text": "<|grounding|>OCR this image."
          }
        ]
      }
    ],
    "temperature": 0.0,
    "top_p": 1.0,
    "top_k": -1,
    "max_tokens": 2048
  }
}
